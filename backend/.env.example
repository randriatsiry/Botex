# Port d'écoute du serveur de production Render Web Service
PORT=3000

# Clé API Google Gemini pour l'IA Copilot
GEMINI_API_KEY=your_gemini_api_key_here

# URL de votre site statique Frontend (Render Static Site) pour configurer CORS de façon sécurisée
# Laissez vide ou avec * pour autoriser toutes les origines par défaut
FRONTEND_URL=*
